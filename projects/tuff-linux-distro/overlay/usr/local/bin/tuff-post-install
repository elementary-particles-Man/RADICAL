#!/bin/bash
set -euo pipefail

export PATH=/usr/local/sbin:/usr/sbin:/sbin:${PATH}

log() {
    echo "[tuff-post-install] $*"
}

mount_efivars_if_possible() {
    if [ -d /sys/firmware/efi ] && [ ! -d /sys/firmware/efi/efivars ]; then
        mkdir -p /sys/firmware/efi/efivars
    fi
    if [ -d /sys/firmware/efi ] && ! mountpoint -q /sys/firmware/efi/efivars 2>/dev/null; then
        mount -t efivarfs efivarfs /sys/firmware/efi/efivars >/dev/null 2>&1 || true
    fi
}

enable_service_if_present() {
    local service="$1"
    if systemctl list-unit-files "${service}" >/dev/null 2>&1; then
        systemctl enable "${service}" >/dev/null 2>&1 || true
    fi
}

remove_duplicate_boot_entries() {
    command -v efibootmgr >/dev/null 2>&1 || return 0

    efibootmgr | awk '
        /^Boot[0-9A-Fa-f]{4}/ {
            bootnum = substr($1, 5, 4)
            line = $0
            sub(/^[^[:space:]]+[[:space:]]+/, "", line)
            if (line ~ /(^|[[:space:]])(debian|Debian|RADICAL)([[:space:]]|$)/) {
                print bootnum
            }
        }
    ' | while read -r bootnum; do
        [ -n "${bootnum}" ] || continue
        efibootmgr -B -b "${bootnum}" >/dev/null 2>&1 || true
    done
}

create_single_radical_entry() {
    command -v efibootmgr >/dev/null 2>&1 || return 0
    mountpoint -q /sys/firmware/efi/efivars 2>/dev/null || return 0

    local esp_source esp_part esp_disk bootnum
    esp_source="$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)"
    [ -n "${esp_source}" ] || return 0

    esp_part="${esp_source##*[!0-9]}"
    esp_disk="${esp_source%p${esp_part}}"
    if [ "${esp_disk}" = "${esp_source}" ]; then
        esp_disk="${esp_source%${esp_part}}"
    fi

    [ -b "${esp_disk}" ] || return 0
    [ -n "${esp_part}" ] || return 0

    efibootmgr --create --disk "${esp_disk}" --part "${esp_part}" --label RADICAL --loader '\EFI\RADICAL\grubx64.efi' >/dev/null 2>&1 || true
    bootnum="$(efibootmgr | awk '/(^Boot[0-9A-Fa-f]{4}.*RADICAL)/ { print substr($1, 5, 4); exit }')"
    [ -n "${bootnum}" ] || return 0
    efibootmgr -o "${bootnum}" >/dev/null 2>&1 || true
}

log "starting"

mount_efivars_if_possible

systemctl set-default multi-user.target >/dev/null 2>&1 || true
enable_service_if_present NetworkManager.service
enable_service_if_present systemd-resolved.service
# RADICAL install media and base installs must not start SDDM/KDE/Plasma as the primary session.
# TUFF-Xwin or another optional desktop layer may enable a display manager explicitly after installation.

if [ -e /run/systemd/resolve/stub-resolv.conf ]; then
    ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
fi

if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="RADICAL"/' /etc/default/grub || true
fi

if command -v grub-install >/dev/null 2>&1 && [ -d /boot/efi/EFI ]; then
    rm -rf /boot/efi/EFI/debian
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=RADICAL --recheck || true
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=RADICAL --recheck --removable --no-nvram || true
    remove_duplicate_boot_entries
    create_single_radical_entry
fi

if command -v update-grub >/dev/null 2>&1; then
    update-grub || true
fi

cat <<'EOF' > /etc/sysctl.d/99-chrome-fix.conf
kernel.unprivileged_userns_clone = 1
kernel.apparmor_restrict_unprivileged_userns = 0
user.max_user_namespaces = 10000
EOF

log "finished"
