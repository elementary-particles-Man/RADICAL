# BOOT-RADICAL environment configuration example
# Rename to boot-radical.env and edit as needed.

# Enable actual build (set to 1 to enable)
RADICAL_BUILD_ENABLED=0

# Dry-run mode (set to false to execute actual commands)
DRY_RUN=true

# RADICAL specific configurations
# RADICAL_IMAGE_TYPE=micro-debian
RADICAL_BOOT_PROFILE=default

# Vulkan readiness gate
# 0 = warn/report only, 1 = fail when Vulkan readiness is not available
RADICAL_VULKAN_STRICT=0

# 1 = accept software Vulkan such as llvmpipe/lavapipe for QEMU/headless validation
# 0 = require non-software hardware Vulkan in strict profiles
RADICAL_VULKAN_ALLOW_SOFTWARE=1

# Timeout for vulkaninfo --summary
RADICAL_VULKANINFO_TIMEOUT_SECONDS=8

# Readiness report path
RADICAL_VULKAN_REPORT_DIR=BOOT-RADICAL/out
# RADICAL_VULKAN_REPORT=BOOT-RADICAL/out/vulkan-readiness.json

# QEMU Boot Smoke Harness Settings
# BOOT_RADICAL_QEMU_IMAGE="out/radical-boot.qcow2"
# BOOT_RADICAL_QEMU_TIMEOUT_SECONDS=30
# BOOT_RADICAL_QEMU_ALLOW_KVM=1
# BOOT_RADICAL_QEMU_ALLOW_MISSING_IMAGE=0
# BOOT_RADICAL_QEMU_NET="none"
# BOOT_RADICAL_QEMU_MEMORY="2048M"
# BOOT_RADICAL_QEMU_SUCCESS_REGEX=""
